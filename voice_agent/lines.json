{
  "version": 1,
  "about": "Hold My Beer voice lines. Each line fires on station events (handoff routine, turn gate, vision moments). The voice only announces: nothing here can start, stop or steer the arm. Edit the text freely, then re-render with python3 -m voice_agent.render. Keys are matched exactly first, then shell-style patterns, then with their last ':part' dropped; 'silent' marks keys that deliberately say nothing.",
  "voices": {
    "righty": {
      "persona": "The right arm, the show-off who takes the can.",
      "say_voice": ["Rocko (English (US))", "Rocko", "Daniel", "Fred"],
      "rate": 185
    },
    "lefty": {
      "persona": "The left arm, calm and unimpressed. Never moves in this demo; it only heckles.",
      "say_voice": ["Samantha (English (US))", "Samantha", "Karen", "Kathy"],
      "rate": 175
    }
  },
  "rules": {
    "same_line_cooldown_s": 8.0,
    "min_gap_s": 0.4,
    "max_wait_s": 3.0,
    "max_queue": 2
  },
  "lines": [
    {"id": "that_look", "voice": "lefty", "text": "Oh no. He's got that look.",
     "on": ["step:waiting_for_go"]},
    {"id": "watch_this", "voice": "righty", "text": "Say no more. Watch this.",
     "on": ["decision:asked_the_arm_to_take_the_can", "decision:asked_the_arm_to_pick_the_can_from_the_mark"]},
    {"id": "company", "voice": "lefty", "text": "Ooh. Company.",
     "on": ["decision:waiting_before_the_arm_moves"]},
    {"id": "hi_there", "voice": "lefty", "text": "Oh! Hi there.",
     "on": ["step:paused", "gate:robot_turn_revoked:hand_present"]},
    {"id": "were_back", "voice": "righty", "text": "And we're back.",
     "on": ["step:*:resumed"]},
    {"id": "beer_me", "voice": "righty", "text": "Beer me.",
     "on": ["step:offer:1"]},
    {"id": "little_help", "voice": "righty", "text": "Uh... little help?",
     "on": ["decision:opened_the_jaws_and_offered_again"]},
    {"id": "say_less", "voice": "righty", "text": "Say less.",
     "on": ["contact:grasp"]},
    {"id": "mine_now", "voice": "righty", "text": "It's mine now.", "on": []},
    {"id": "thank_you", "voice": "righty", "text": "Thank you kindly.",
     "on": ["contact:release", "moment:can_released"]},
    {"id": "up_we_go", "voice": "righty", "text": "Up we go.", "on": []},
    {"id": "held", "voice": "righty", "text": "Hold my beer? Held.",
     "on": ["step:done"]},
    {"id": "show_off", "voice": "lefty", "text": "Show-off.",
     "on": ["end:success:held"]},
    {"id": "keep_it", "voice": "righty", "text": "Fine. Keep it.",
     "on": ["end:failed:person_kept_holding"]},
    {"id": "left_hanging", "voice": "righty", "text": "Left hanging. Classic.",
     "on": ["end:failed:no_can_presented"]},
    {"id": "meant_that", "voice": "righty", "text": "I meant to do that.",
     "on": ["end:failed:no_grasp"]},
    {"id": "that_was_mine", "voice": "righty", "text": "Hey! That was mine.",
     "on": ["contact:drop"]},
    {"id": "where_did_you_go", "voice": "righty", "text": "Wait. Where'd you go?",
     "on": ["end:failed:release_not_seen"]},
    {"id": "wheres_the_can", "voice": "righty", "text": "Where'd the can go?",
     "on": ["end:failed:missed_can", "end:failed:can_not_at_mark"]},
    {"id": "overheating", "voice": "lefty", "text": "He's overheating. Again.", "urgent": true,
     "on": ["end:failed:motor_hot"]},
    {"id": "scene", "voice": "lefty", "text": "And... scene.", "urgent": true,
     "on": ["end:stopped:operator_stop", "end:stopped"]},
    {"id": "tech_difficulties", "voice": "lefty", "text": "Technical difficulties.", "urgent": true,
     "on": ["end:failed:arm_error"]},
    {"id": "never_mind", "voice": "lefty", "text": "Okay. Never mind.",
     "on": ["end:stopped:no_go", "end:stopped:not_resumed", "end:failed:path_never_cleared"]},
    {"id": "that_happened", "voice": "lefty", "text": "Well. That happened.",
     "on": ["end:failed"]},
    {"id": "his_corner", "voice": "lefty", "text": "Back to his corner.",
     "on": ["step:reset"]},
    {"id": "lights_out", "voice": "lefty", "text": "Who turned off the lights?",
     "on": ["gate:robot_turn_revoked:stale_observation", "gate:robot_turn_revoked:invalid_observation",
            "moment:observation_invalid"]},
    {"id": "my_turn", "voice": "righty", "text": "My turn.",
     "on": ["gate:robot_turn_granted"]},
    {"id": "nailed_it", "voice": "righty", "text": "Nailed it.",
     "on": ["gate:robot_turn_completed"]},
    {"id": "cold_open", "voice": "lefty", "text": "Folks, he's about to say it.", "on": []},
    {"id": "bow", "voice": "righty", "text": "I was better.", "on": []},
    {"id": "bow_reply", "voice": "lefty", "text": "You were fine.", "on": []}
  ],
  "silent": [
    "task", "state", "arm_calls", "trial", "handoff_gate", "vision_action", "vision_gate",
    "step:approach", "step:descend", "step:release", "step:lift", "step:grasp", "step:retreat", "step:confirm", "step:halted",
    "step:offer", "end:success", "decision",
    "gate:holding", "gate:turn_requested", "gate:robot_turn_revoked",
    "moment:hand_entered", "moment:offer_started", "moment:offer_steady",
    "moment:hand_withdrawn", "moment:offer_withdrawn", "moment:hand_returned", "moment:observation_recovered"
  ]
}
