#!/bin/bash
set -euo pipefail
tool_dir="$(cd "$(dirname "$0")" && pwd)"

usage() {
  echo "Usage: bash arm/tools/arm {scan|watch|diagnose|claw_probe|wrist_probe|lift_probe|calibration_sweep|test} [arguments]"
  echo "No command runs by default. --help and test do not access hardware."
}

case "${1:---help}" in
  --help|-h) usage; exit 0 ;;
  scan) script=scan_arms.py ;;
  watch) script=watch_arms.py ;;
  diagnose) script=diagnose_arms.py ;;
  claw_probe) script=claw_probe.py ;;
  wrist_probe) script=wrist_probe.py ;;
  lift_probe) script=lift_probe.py ;;
  calibration_sweep) script=calibration_sweep.py ;;
  test) script= ;;
  *) usage >&2; exit 2 ;;
esac
tool="$1"
shift
python="${ARMCTL_PYTHON:-$tool_dir/../.venv/bin/python}"
if ! command -v "$python" >/dev/null 2>&1; then
  echo "Python environment missing. Follow arm/README.md or set ARMCTL_PYTHON." >&2
  exit 1
fi
if [[ "$(uname -s)" == Darwin ]] && command -v brew >/dev/null 2>&1; then
  prefix="$(brew --prefix libusb)"
  export DYLD_FALLBACK_LIBRARY_PATH="$prefix/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
fi
if [[ "$tool" == test ]]; then
  exec "$python" -m pytest -q "$tool_dir/test_claw_probe.py" "$tool_dir/test_portability.py" "$tool_dir/test_diagnose_arms.py" "$tool_dir/test_wrist_probe.py" "$tool_dir/test_lift_probe.py" "$tool_dir/test_table_reference.py" "$@"
fi
exec "$python" "$tool_dir/$script" "$@"
