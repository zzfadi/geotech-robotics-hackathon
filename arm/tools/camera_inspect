#!/bin/bash
# Build a local macOS camera-permission app and save timestamped snapshots.
set -euo pipefail
if [[ "${1:---help}" == --help || "${1:---help}" == -h ]]; then
  echo 'Usage: bash arm/tools/camera_inspect NEW_OUTPUT_DIRECTORY [FRAMES_1_TO_100] [CAMERA_ID_OR_all]'
  echo 'Captures three KD-USB cameras and the MacBook camera locally; no network or arm access.'
  exit 0
fi
if [[ $# -lt 1 || $# -gt 3 || "$(uname -s)" != Darwin ]]; then
  echo 'Requires macOS and a new output directory.' >&2
  exit 2
fi
frames="${2:-1}"
if [[ ! "$frames" =~ ^[1-9][0-9]?$ && "$frames" != 100 ]]; then
  echo 'Frame count must be between 1 and 100.' >&2
  exit 2
fi
tool_dir="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$1"
output_dir="$(cd "$1" && pwd)"
if [[ -e "$output_dir/camera-report.json" || -e "$output_dir/capture-ready.txt" ]]; then
  echo 'Output directory already contains a capture; choose a new directory.' >&2
  exit 2
fi
app_dir="$tool_dir/../local/MakerArmCamera.app"
mkdir -p "$app_dir/Contents/MacOS"
cat > "$app_dir/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>MakerArmCamera</string>
<key>CFBundleIdentifier</key><string>local.makerarm.camera-inspection</string>
<key>CFBundleName</key><string>Maker Arm Camera Inspector</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>NSCameraUsageDescription</key><string>Inspect the robot and laptop cameras and save local diagnostic frames requested by the operator.</string>
<key>LSUIElement</key><true/>
</dict></plist>
PLIST
if [[ ! -x "$app_dir/Contents/MacOS/MakerArmCamera" || "$tool_dir/camera_inspect.swift" -nt "$app_dir/Contents/MacOS/MakerArmCamera" ]]; then
  xcrun swiftc "$tool_dir/camera_inspect.swift" -o "$app_dir/Contents/MacOS/MakerArmCamera"
fi
codesign --force --sign - "$app_dir"
open -W -n "$app_dir" --args "$output_dir" "$frames" "${3:-all}"
if [[ ! -f "$output_dir/camera-report.json" ]]; then
  echo 'No camera report produced; inspect camera permission or app startup.' >&2
  exit 1
fi
echo "Camera report: $output_dir/camera-report.json"
python3 - "$output_dir/camera-report.json" <<'PY'
import json, sys
r = json.load(open(sys.argv[1]))
ok = bool(r.get('access_granted') and r.get('cameras') and not r.get('error'))
for c in r.get('cameras', []):
    capture = c.get('capture', {})
    print(c['name'], c['unique_id'], capture.get('error', capture.get('image', 'no frame')))
    ok = ok and bool(capture.get('image')) and not capture.get('error')
sys.exit(0 if ok else 1)
PY
